# Only reviewed website files belong in this repository.
/*
!/.gitignore
!/.nojekyll
!/README.md
!/index.html
!/styles.css
!/fonts.css
!/site.js
!/media.js
!/site.config.json
!/site.content.json
!/favicon.svg
!/robots.txt
!/_headers
!/assets/
/assets/*
!/assets/*.png
!/assets/THIRD_PARTY_NOTICES.txt
!/assets/fonts/
/assets/fonts/*
!/assets/fonts/inter-latin.woff2
!/assets/fonts/fraunces-latin.woff2
!/assets/fonts/Inter-OFL.txt
!/assets/fonts/Fraunces-OFL.txt
!/assets/teaser.mp4
!/assets/apex-real.mp4
!/assets/revo2-real.mp4
!/assets/*.pdf
!/assets/video/
/assets/video/*
!/assets/video/*.mp4
!/assets/video/*.png
!/assets/video/*.jpg
!/assets/video/*.webp
!/viewer/
/viewer/*
!/viewer/grasp-viewer.js
!/viewer/grasp-engine.js
!/viewer/grasp-engine.bundle.js
!/vendor/
/vendor/*
!/vendor/three/
/vendor/three/*
!/vendor/three/three.module.min.js
!/vendor/three/three.core.min.js
!/vendor/three/GLTFLoader.js
!/vendor/three/OrbitControls.js
!/vendor/three/BufferGeometryUtils.js
!/vendor/three/LICENSE.txt
!/grasps/
/grasps/*
!/grasps/catalog.json
!/grasps/selection.json
!/grasps/README.md
!/grasps/geometry/
!/grasps/poses/
!/grasps/payloads/
!/grasps/previews/
/grasps/previews/*
!/grasps/previews/manifest.json
!/grasps/previews/allegro.png
!/grasps/previews/barrett.png
!/grasps/previews/shadowhand.png
!/grasps/previews/apex_hand.png
!/grasps/previews/leaphand.png
!/grasps/previews/robotiq_3finger.png
